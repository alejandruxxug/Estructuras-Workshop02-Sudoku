<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="post-card" xmlns:fx="http://javafx.com/fxml">
    <HBox styleClass="post-header">
        <StackPane fx:id="avatar" styleClass="post-avatar">
            <Label fx:id="avatarLetter" text="?"/>
        </StackPane>
        <VBox>
            <Label fx:id="displayName" text="Animatronic" styleClass="post-name"/>
            <Label fx:id="handle" text="@handle · ahora" styleClass="post-handle"/>
        </VBox>
    </HBox>
    <Label fx:id="body" styleClass="post-body" wrapText="true"
           text="Lorem ipsum sudoku dolor sit amet."/>
</VBox>
